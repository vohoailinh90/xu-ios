    },
    "Ghi khoản quen" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log quick pick"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつものを記録"
          }
        }
      }
    },
    "Ghi một khoản chi bằng một câu, ví dụ \"cà phê 35k\"." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log an expense with one sentence, like \"coffee 35k\"."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「コーヒー 350円」のように、ひと言で支出を記録します。"
