{
  "sourceLanguage" : "vi",
  "strings" : {
    "Bạn vừa tiêu gì?" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What did you just spend on?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何に使いましたか?"
          }
        }
      }
    },
    "Dùng trong Tự động hóa › Giao dịch để tự ghi khi quẹt Apple Pay." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use in Automation › Transaction to log Apple Pay payments automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オートメーションで使うと、Apple Payの支払いを自動で記録します。"
          }
        }
      }
    },
    "Ghi chi tiêu" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log expense"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出を記録"
          }
        }
      }
    },
    "Ghi giao dịch thẻ" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log card payment"
